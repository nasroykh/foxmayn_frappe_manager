      --lan                   Publish the copy's ports on all interfaces
      --no-files              Leave the site's attachments behind
      --no-ssl                Production copy without Let's Encrypt
      --vendor-apps strings   Carry these apps' working trees, uncommitted changes included ('all' for every app)

