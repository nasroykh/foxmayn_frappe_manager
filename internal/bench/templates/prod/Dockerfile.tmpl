FROM docker.io/frappe/bench:{{.BenchImageTag}}

USER root
{{- if .HostUID}}

# Remap the in-container `frappe` user (uid 1000 in frappe/bench) onto the host
# user's ids so files crossing the ./workspace bind mount are owned consistently
# in both directions. Required wherever the host uid is not 1000 — notably
# GitHub-hosted runners, where `runner` is uid 1001: without this, bench init
# cannot write into the workspace directory the host created, and the host
# cannot write wsgi.py into the sites/ directory the container created.
RUN set -eu; \
    if [ "$(id -u frappe)" != "{{.HostUID}}" ] || [ "$(id -g frappe)" != "{{.HostGID}}" ]; then \
        if getent group {{.HostGID}} >/dev/null 2>&1; then \
            usermod -g {{.HostGID}} frappe; \
        else \
            groupmod -g {{.HostGID}} frappe; \
        fi; \
        usermod -u {{.HostUID}} frappe; \
        chown -R {{.HostUID}}:{{.HostGID}} /home/frappe; \
    fi
{{- end}}
{{- if eq .DBType "postgres"}}

# PostgreSQL {{.PostgresMajor}} client. The base image ships an older pg_dump, which refuses to
# dump a newer server ("aborting because of server version mismatch"), so
# backup, snapshot, clone and update's pre-backup all fail. The PGDG repo is
# set up by postgresql-common's own script (keyring bundled in the package, no
# key download). Frappe runs /usr/bin/pg_dump, Debian's pg_wrapper, which with
# no cluster selected picks the newest installed client; the check fails the
# build if it does not resolve to {{.PostgresMajor}}.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates postgresql-common \
    && /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh -y \
    && apt-get install -y --no-install-recommends postgresql-client-{{.PostgresMajor}} \
    && rm -rf /var/lib/apt/lists/* \
    && pg_dump --version | grep -q ' {{.PostgresMajor}}\.' \
    && psql --version | grep -q ' {{.PostgresMajor}}\.'
{{- end}}
{{- if .NodeMajor}}

# Node {{.NodeMajor}} for this bench's Frappe branch. PATH reaches node through
# ~/.nvm/current, which `nvm use` repoints (the base image sets
# NVM_SYMLINK_CURRENT); the default alias covers shells that source nvm.sh.
# It runs before corepack, which puts its shims next to the active node.
USER frappe
RUN bash -c '. "$NVM_DIR/nvm.sh" && nvm alias default {{.NodeMajor}} >/dev/null && nvm use {{.NodeMajor}} >/dev/null' \
    && node --version | grep -q '^v{{.NodeMajor}}\.'
USER root
{{- end}}
RUN corepack enable pnpm
USER frappe
