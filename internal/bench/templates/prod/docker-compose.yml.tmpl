x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

# No process in these containers needs to gain privileges after start (the
# database and Redis images drop theirs with gosu/su-exec, which is allowed).
# Not on dev benches, where the frappe user may use sudo.
x-security: &default-security
  - no-new-privileges:true

services:
{{- if eq .DBType "postgres"}}
  postgres:
    image: docker.io/postgres:18
    environment:
      POSTGRES_PASSWORD: "{{.DBRootPassword}}"
    volumes:
      - postgres-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped
    logging: *default-logging
    security_opt: *default-security
{{- else}}
  mariadb:
    image: docker.io/mariadb:11.8
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
      - --skip-innodb-read-only-compressed
      - --innodb-buffer-pool-size={{.MariaDBBufferPool}}
      - --innodb-log-file-size=256M
      # 1 flushes the redo log at every commit: a crash loses no committed
      # transaction. 2 (--mariadb-fast-commit) can lose about a second of them.
      - --innodb-flush-log-at-trx-commit={{if .MariaDBFastCommit}}2{{else}}1{{end}}
      - --innodb-flush-method=O_DIRECT
      - --tmp-table-size=64M
      - --max-heap-table-size=64M
      - --join-buffer-size=2M
      - --sort-buffer-size=2M
{{- if .SlowQueryLog}}
      - --slow-query-log=1
      - --slow-query-log-file=/var/log/mysql/slow.log
      - --long-query-time=2
{{- end}}
    environment:
      MYSQL_ROOT_PASSWORD: "{{.DBRootPassword}}"
      MARIADB_AUTO_UPGRADE: 1
    volumes:
      - mariadb-data:/var/lib/mysql
{{- if .SlowQueryLog}}
      - ./mysql-logs:/var/log/mysql
{{- end}}
    healthcheck:
      # The password comes from the container's own environment, so it is not
      # written here a second time or passed as an argument.
      test: ["CMD-SHELL", "MYSQL_PWD=\"$${MYSQL_ROOT_PASSWORD}\" mariadb -u root -e 'SELECT 1'"]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped
    logging: *default-logging
    security_opt: *default-security
{{- end}}

  redis-cache:
    image: docker.io/redis:8-alpine
    command: ["redis-server", "--maxmemory", "{{.RedisCacheMaxmem}}", "--maxmemory-policy", "allkeys-lru"]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    restart: unless-stopped
    logging: *default-logging
    security_opt: *default-security

  redis-queue:
    image: docker.io/redis:8-alpine
    # The job queue is state: on a volume with an append-only file, queued
    # jobs survive the container being replaced (reconcile, recreate, upgrade).
    command: ["redis-server", "--maxmemory", "{{.RedisQueueMaxmem}}", "--maxmemory-policy", "noeviction", "--appendonly", "yes"]
    volumes:
      - redis-queue-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    restart: unless-stopped
    logging: *default-logging
    security_opt: *default-security

  frappe:
    build:
      context: .
    # The flags bench's own production config uses, plus a heartbeat directory
    # in memory: --max-requests recycles workers that leak, --graceful-timeout
    # lets requests finish on a restart.
    command: ["bash", "-c", "cd /workspace/frappe-bench && env/bin/gunicorn --chdir /workspace/frappe-bench/sites -b 0.0.0.0:8000 -w {{.GunicornWorkers}} --threads 4 -t 120 --graceful-timeout 30 --max-requests 5000 --max-requests-jitter 500 --worker-tmp-dir /dev/shm wsgi:application"]
    working_dir: /workspace/frappe-bench
    environment:
      - UV_CACHE_DIR=/home/frappe/.cache/pip/uv
      - UV_LINK_MODE=copy
      - YARN_CACHE_FOLDER=/home/frappe/.cache/pip/yarn
    volumes:
      - ./workspace:/workspace
      - pip-cache:/home/frappe/.cache/pip
    ports:
      - "{{if .PublishHost}}{{.PublishHost}}:{{end}}{{.WebPort}}:8000"
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "--max-time", "5", "http://127.0.0.1:8000/api/method/ping"]
      interval: 15s
      timeout: 8s
      retries: 5
      start_period: 60s
    security_opt: *default-security
    depends_on:
{{- if eq .DBType "postgres"}}
      postgres:
        condition: service_healthy
{{- else}}
      mariadb:
        condition: service_healthy
{{- end}}
    restart: unless-stopped
    logging: *default-logging
    networks:
      default: {}
      ffm-proxy: {}
    labels:
{{- if .NoSSL}}
      - "traefik.enable=true"
      - "traefik.docker.network=ffm-proxy"
      - "traefik.http.routers.{{.Name}}.rule=Host(`{{.Domain}}`)"
      - "traefik.http.routers.{{.Name}}.entrypoints=web"
      - "traefik.http.services.{{.Name}}.loadbalancer.server.port=8000"
{{- else}}
      - "traefik.enable=true"
      - "traefik.docker.network=ffm-proxy"
      # HTTPS router
      - "traefik.http.routers.{{.Name}}.rule=Host(`{{.Domain}}`)"
      - "traefik.http.routers.{{.Name}}.entrypoints=websecure"
      - "traefik.http.routers.{{.Name}}.tls.certresolver=letsencrypt"
      - "traefik.http.services.{{.Name}}.loadbalancer.server.port=8000"
      # HTTP → HTTPS redirect (per-bench, leaves dev benches on :80 untouched)
      - "traefik.http.routers.{{.Name}}-redirect.rule=Host(`{{.Domain}}`)"
      - "traefik.http.routers.{{.Name}}-redirect.entrypoints=web"
      - "traefik.http.middlewares.{{.Name}}-redirect.redirectscheme.scheme=https"
      - "traefik.http.routers.{{.Name}}-redirect.middlewares={{.Name}}-redirect"
{{- end}}
{{- if .HasAliases}}
      # Domain aliases (LAN names, secondary hostnames). Kept on their own router
      # instead of being added to the primary rule: Traefik derives one ACME
      # certificate request per router, so folding a name that Let's Encrypt
      # cannot reach into the primary rule would fail the order and leave the
      # real domain with no certificate at all.
      - "traefik.http.routers.{{.Name}}-alias.rule={{.AliasRule}}"
      - "traefik.http.routers.{{.Name}}-alias.entrypoints={{.AliasEntrypoint}}"
      - "traefik.http.routers.{{.Name}}-alias.service={{.Name}}"
{{- if .AliasTLS}}
      - "traefik.http.routers.{{.Name}}-alias.tls.certresolver=letsencrypt"
      - "traefik.http.routers.{{.Name}}-alias-redirect.rule={{.AliasRule}}"
      - "traefik.http.routers.{{.Name}}-alias-redirect.entrypoints=web"
      - "traefik.http.routers.{{.Name}}-alias-redirect.service={{.Name}}"
      - "traefik.http.routers.{{.Name}}-alias-redirect.middlewares={{.Name}}-redirect"
{{- end}}
{{- end}}

  socketio:
    build:
      context: .
    command: ["bash", "-c", "cd /workspace/frappe-bench && node apps/frappe/socketio.js"]
    environment:
      - FRAPPE_SOCKETIO_PORT=9000
    working_dir: /workspace/frappe-bench
    volumes:
      - ./workspace:/workspace
    ports:
      - "{{if .PublishHost}}{{.PublishHost}}:{{end}}{{.SocketIOPort}}:9000"
    healthcheck:
      test: ["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/9000"]
      interval: 15s
      timeout: 5s
      retries: 5
    security_opt: *default-security
    depends_on:
      frappe:
        condition: service_healthy
    restart: unless-stopped
    logging: *default-logging
    networks:
      default: {}
      ffm-proxy: {}
    labels:
{{- if .NoSSL}}
      - "traefik.enable=true"
      - "traefik.docker.network=ffm-proxy"
      - "traefik.http.routers.{{.Name}}-socketio.rule=Host(`{{.Domain}}`) && PathPrefix(`/socket.io`)"
      - "traefik.http.routers.{{.Name}}-socketio.entrypoints=web"
      - "traefik.http.routers.{{.Name}}-socketio.middlewares={{.Name}}-socketio-origin"
      - "traefik.http.services.{{.Name}}-socketio.loadbalancer.server.port=9000"
      - "traefik.http.middlewares.{{.Name}}-socketio-origin.headers.customRequestHeaders.Origin=http://{{.Domain}}"
{{- else}}
      - "traefik.enable=true"
      - "traefik.docker.network=ffm-proxy"
      - "traefik.http.routers.{{.Name}}-socketio.rule=Host(`{{.Domain}}`) && PathPrefix(`/socket.io`)"
      - "traefik.http.routers.{{.Name}}-socketio.entrypoints=websecure"
      - "traefik.http.routers.{{.Name}}-socketio.tls.certresolver=letsencrypt"
      - "traefik.http.routers.{{.Name}}-socketio.middlewares={{.Name}}-socketio-origin"
      - "traefik.http.services.{{.Name}}-socketio.loadbalancer.server.port=9000"
      - "traefik.http.middlewares.{{.Name}}-socketio-origin.headers.customRequestHeaders.Origin=https://{{.Domain}}"
{{- end}}
{{- if .HasAliases}}
      # Socket.IO over a domain alias. Traefik's default priority is rule length,
      # so this beats the plain alias router on the frappe container for
      # /socket.io — the same ordering the primary domain already relies on.
      - "traefik.http.routers.{{.Name}}-alias-socketio.rule=({{.AliasRule}}) && PathPrefix(`/socket.io`)"
      - "traefik.http.routers.{{.Name}}-alias-socketio.entrypoints={{.AliasEntrypoint}}"
      - "traefik.http.routers.{{.Name}}-alias-socketio.service={{.Name}}-socketio"
{{- if .AliasTLS}}
      - "traefik.http.routers.{{.Name}}-alias-socketio.tls.certresolver=letsencrypt"
{{- end}}
      - "traefik.http.routers.{{.Name}}-alias-socketio.middlewares={{.Name}}-alias-socketio-headers"
      # Remove Origin instead of pinning it. The primary router sets a fixed
      # Origin, which would not match an alias Host and would be rejected by
      # realtime/middlewares/authenticate.js; ffm's patch skips the check when
      # Origin is absent (an empty customRequestHeaders value deletes the header).
      # X-Frappe-Site-Name then keeps the socket.io namespace check passing on a
      # hostname that is not the site name.
      - "traefik.http.middlewares.{{.Name}}-alias-socketio-headers.headers.customRequestHeaders.Origin="
      - "traefik.http.middlewares.{{.Name}}-alias-socketio-headers.headers.customRequestHeaders.X-Frappe-Site-Name={{.SiteName}}"
{{- end}}

  worker-long:
    build:
      context: .
    command: ["bash", "-c", "cd /workspace/frappe-bench && bench worker --queue long,default,short"]
    working_dir: /workspace/frappe-bench
    volumes:
      - ./workspace:/workspace
      - pip-cache:/home/frappe/.cache/pip
    depends_on:
      frappe:
        condition: service_healthy
    restart: unless-stopped
    logging: *default-logging
    security_opt: *default-security
    deploy:
      replicas: {{.WorkerLongCount}}

  worker-short:
    build:
      context: .
    command: ["bash", "-c", "cd /workspace/frappe-bench && bench worker --queue short,default"]
    working_dir: /workspace/frappe-bench
    volumes:
      - ./workspace:/workspace
      - pip-cache:/home/frappe/.cache/pip
    depends_on:
      frappe:
        condition: service_healthy
    restart: unless-stopped
    logging: *default-logging
    security_opt: *default-security
    deploy:
      replicas: {{.WorkerShortCount}}

  scheduler:
    build:
      context: .
    command: ["bash", "-c", "cd /workspace/frappe-bench && bench schedule"]
    working_dir: /workspace/frappe-bench
    volumes:
      - ./workspace:/workspace
      - pip-cache:/home/frappe/.cache/pip
    depends_on:
      frappe:
        condition: service_healthy
    restart: unless-stopped
    logging: *default-logging
    security_opt: *default-security

volumes:
{{- if eq .DBType "postgres"}}
  postgres-data:
{{- else}}
  mariadb-data:
{{- end}}
  pip-cache:
  redis-queue-data:

networks:
  default: {}
  ffm-proxy:
    external: true
