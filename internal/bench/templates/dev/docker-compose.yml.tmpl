services:
{{- if eq .DBType "postgres"}}
  postgres:
    image: docker.io/postgres:18
    environment:
      POSTGRES_PASSWORD: "{{.DBRootPassword}}"
    volumes:
      - postgres-data:/var/lib/postgresql
{{- else}}
  mariadb:
    image: docker.io/mariadb:11.8
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
      - --skip-innodb-read-only-compressed
      - --innodb-buffer-pool-size=256M
      - --innodb-flush-method=O_DIRECT
      - --tmp-table-size=64M
      - --max-heap-table-size=64M
    environment:
      MYSQL_ROOT_PASSWORD: "{{.DBRootPassword}}"
      MARIADB_AUTO_UPGRADE: 1
    volumes:
      - mariadb-data:/var/lib/mysql
{{- end}}

  redis-cache:
    image: docker.io/redis:8-alpine

  redis-queue:
    image: docker.io/redis:8-alpine

  # Catches every mail the bench sends: site_config's mail_server points here
  # unless the site has its own default outgoing Email Account. The web UI is
  # published on the web port + 6 ('ffm mail'); SMTP stays on the bench network.
  mailpit:
    image: docker.io/axllent/mailpit:v1.31.4
    environment:
      MP_MAX_MESSAGES: 5000
    ports:
      - "{{if .PublishHost}}{{.PublishHost}}:{{end}}{{.MailPort}}:8025"

  frappe:
    build:
      context: .
    command: sleep infinity
    # PID 1 is `sleep infinity`, which never reaps children. honcho's child
    # processes (web, socketio, workers) get reparented to PID 1 when the dev
    # server is restarted and pile up as zombies. tini (init: true) reaps them.
    init: true
    environment:
      - SHELL=/bin/zsh
      - FRAPPE_SOCKETIO_PORT=9000
      # bench installs Python packages with uv. Its cache lives in the
      # pip-cache volume: a volume of its own would mount over a path the image
      # does not have, and Docker would create it root-owned (yarn-cache has
      # that problem). The virtualenv is on the ./workspace bind mount, a
      # different filesystem, so uv copies instead of hardlinking.
      - UV_CACHE_DIR=/home/frappe/.cache/pip/uv
      - UV_LINK_MODE=copy
{{- if .ForwardSSHAgent}}
      - SSH_AUTH_SOCK=/ssh-agent
{{- end}}
    volumes:
      - ./workspace:/workspace
      - pip-cache:/home/frappe/.cache/pip
      - yarn-cache:/home/frappe/.cache/yarn
{{- if .ForwardSSHAgent}}
      # A default keeps compose usable when SSH_AUTH_SOCK is unset (cron,
      # sudo, the dashboard daemon); the bench then simply has no agent.
      - ${SSH_AUTH_SOCK:-/dev/null}:/ssh-agent
{{- end}}
    working_dir: /workspace/frappe-bench
    ports:
      - "{{if .PublishHost}}{{.PublishHost}}:{{end}}{{.WebPort}}-{{.WebPortEnd}}:8000-8005"
      - "{{if .PublishHost}}{{.PublishHost}}:{{end}}{{.SocketIOPort}}-{{.SocketIOPortEnd}}:9000-9005"
    networks:
      default: {}
      ffm-proxy: {}
    labels:
      # VS Code Dev Containers — enables "Attach to Running Container" with the
      # correct remote user without requiring any additional configuration.
      - "devcontainer.metadata=[{\"remoteUser\": \"frappe\", \"workspaceFolder\": \"/workspace/frappe-bench\"}]"
      # Traefik reverse-proxy labels — enable sitename.localhost routing.
      # These are harmless when the proxy is not running.
      - "traefik.enable=true"
      # Scope routing to the shared ffm-proxy network to prevent Traefik from
      # randomly selecting the wrong network when a container has multiple NICs.
      - "traefik.docker.network=ffm-proxy"
      # Matches <name>.localhost plus any domain alias. Dev has a single plain
      # HTTP router, so aliases just join the rule. Socket.IO is deliberately
      # NOT routed through Traefik here: the dev client appends socketio_port to
      # the page origin, so it reaches the published 9000-9005 range directly,
      # and moving it onto :80 would break plain http://localhost:<web-port>.
      - "traefik.http.routers.{{.Name}}.rule={{.RouterRule}}"
      - "traefik.http.routers.{{.Name}}.entrypoints=web"
      - "traefik.http.services.{{.Name}}.loadbalancer.server.port=8000"

volumes:
{{- if eq .DBType "postgres"}}
  postgres-data:
{{- else}}
  mariadb-data:
{{- end}}
  pip-cache:
  yarn-cache:

networks:
  # The default network is implicit but must be listed explicitly once the
  # frappe service declares its own networks block.
  default: {}
  # Shared external network managed by 'ffm proxy start'.
  # The network is created automatically by 'ffm create' (even without the
  # proxy running) so that docker compose up never fails due to a missing
  # external network.
  ffm-proxy:
    external: true
